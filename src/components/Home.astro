---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import { Badge } from "@/components/starwind/badge";
import { getForecast, getOverview } from "@/lib/jma/client";
import { normalizeForecast } from "@/lib/jma/normalize";
import { FORMATS, type FormatName } from "@/lib/transformers";
import { iconCategory } from "@/lib/transformers/helpers";
import { AREAS_URL, weatherUrl } from "@/config";

const TOKYO = "130000";
const [reports, overview] = await Promise.all([
  getForecast(TOKYO),
  getOverview(TOKYO),
]);
const norm = normalizeForecast(TOKYO, "東京都", "関東甲信", reports, overview);

const formatKeys = Object.keys(FORMATS) as FormatName[];
const samples = Object.fromEntries(
  formatKeys.map((k) => [
    k,
    JSON.stringify(FORMATS[k].transform(norm), null, 2),
  ]),
);
const today = norm.forecast[0];
const icon = (code: string) => `/icons/${iconCategory(code)}.svg`;

/** pre に安全に埋め込むため HTML エスケープする */
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&").replace(/</g, "<").replace(/>/g, ">");

/** ISO 日時文字列を日本時間(JST)の自然な日本語表記に整形（例: 2026年8月20日 11時00分） */
const formatDate = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const parts = new Intl.DateTimeFormat("ja-JP", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "numeric",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(d);
  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
  return `${get("year")}年${get("month")}月${get("day")}日 ${get(
    "hour",
  )}時${get("minute")}分`;
};
---

<section class="not-content mx-auto max-w-5xl px-4 py-8 sm:py-12">
  <!-- Hero -->
  <div class="hero-block text-center">
    <div class="hero-badges flex items-center justify-center gap-2">
      <Badge variant="outline">気象庁ソース</Badge>
      <Badge variant="outline">12フォーマット対応</Badge>
      <Badge variant="outline">SSG</Badge>
    </div>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      JP All Weather API
    </h1>
    <p class="hero-desc mx-auto max-w-2xl text-lg text-muted-foreground">
      気象庁の天気予報データを
      <strong>Livedoor天気API</strong>・<strong>WeatherAPI.com</strong>・<strong
        >OpenWeatherMap</strong
      >
      など、12種類の形式へ変換して配信するAPIです。全国の予報区（約58）をカバーします。
    </p>
  </div>

  <!-- 東京 天気デモ -->
  <Card class="demo-card">
    <CardHeader class="flex flex-row items-center justify-between">
      <div>
        <CardTitle>{norm.areaName} の天気（{norm.officeName}）</CardTitle>
        <CardDescription>
          発表: {formatDate(norm.reportDatetime)} ／ データ出典: {
            norm.publishingOffice
          }（加工して作成）
        </CardDescription>
      </div>
      <img
        src={icon(today.weatherCode)}
        alt={today.weather}
        width="64"
        height="64"
      />
    </CardHeader>
    <CardContent>
      <div class="pb-4 flex flex-wrap items-center gap-3">
        <div class="flex items-baseline gap-2">
          <span class="text-4xl sm:text-5xl font-bold"
            >{today.tempMax ?? "--"}°C</span
          >
          <span class="text-xs sm:text-sm text-muted-foreground"
            >最高 / 最低 {today.tempMin ?? "--"}°C</span
          >
        </div>
        <div class="flex flex-wrap items-center gap-2 max-w-full">
          <Badge
            class="whitespace-normal wrap-break-word text-left leading-snug py-1"
          >
            {today.weather}
          </Badge>
          {
            today.pop !== null && (
              <Badge variant="outline" class="shrink-0">
                降水 {today.pop}%
              </Badge>
            )
          }
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 md:grid-cols-7">
        {
          norm.forecast.map((f) => (
            <div class="flex flex-col items-center justify-between rounded-lg border p-2 text-center min-h-32.5">
              <span class="text-xs text-muted-foreground font-medium">
                {f.dateLabel}
              </span>
              <img
                src={icon(f.weatherCode)}
                alt={f.weather}
                title={f.weather}
                width="32"
                height="32"
                class="my-1"
              />
              <span class="text-[11px] leading-tight text-foreground line-clamp-2 px-1 my-1">
                {f.weather}
              </span>
              <div class="flex items-center gap-1 text-xs">
                <span class="font-semibold text-red-600 dark:text-red-400">
                  {f.tempMax ?? "--"}°
                </span>
                <span class="text-muted-foreground">/</span>
                <span class="text-blue-600 dark:text-blue-400">
                  {f.tempMin ?? "--"}°
                </span>
              </div>
            </div>
          ))
        }
      </div>
      {
        norm.overviewText && (
          <p class="overview-text text-sm text-muted-foreground">
            {norm.overviewText}
          </p>
        )
      }
    </CardContent>
  </Card>

  <!-- フォーマット紹介 -->
  <h2 class="section-heading text-2xl font-bold">対応フォーマット</h2>
  <div class="formats-grid grid gap-6 sm:grid-cols-2">
    {
      formatKeys.map((k) => (
        <Card class="min-w-0">
          <CardHeader>
            <CardTitle>{FORMATS[k].label}</CardTitle>
            <CardDescription class="wrap-break-word">
              {FORMATS[k].description}
            </CardDescription>
          </CardHeader>
          <CardContent class="min-w-0">
            <code class="block overflow-x-auto whitespace-nowrap rounded-md bg-muted p-2 text-xs">
              GET /api/{k}/{"{area}"}.json
            </code>
            <pre
              class="format-sample max-h-56 max-w-full overflow-auto rounded-md bg-muted p-3 text-xs"
              set:html={escapeHtml(samples[k])}
            />
          </CardContent>
        </Card>
      ))
    }
  </div>

  <!-- クイックスタート -->
  <h2 class="section-heading text-2xl font-bold">クイックスタート</h2>
  <Card class="quickstart-card">
    <CardContent>
      <div class="quickstart-step">
        <p class="font-medium text-sm">1. エリア一覧を取得</p>
        <pre
          class="overflow-auto rounded-md bg-muted p-3 text-xs">curl {AREAS_URL}</pre>
      </div>
      <div class="quickstart-step">
        <p class="font-medium text-sm">2. 天気を取得（例: 東京都 130000）</p>
        <pre
          class="overflow-auto rounded-md bg-muted p-3 text-xs">curl "{weatherUrl("livedoor", "130000")}"</pre>
      </div>
    </CardContent>
  </Card>

  <div
    class="note-box rounded-lg border p-5 text-center text-xs text-muted-foreground"
  >
    <p>
      出典: <a
        href="https://www.jma.go.jp/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline hover:text-foreground">気象庁</a
      >（本APIの気象データは気象庁の公開情報を加工・配信している非公式サービスです）
    </p>
    <p>
      言及されている各社製品名・サービス名は各権利者の商標です。データ構造上の互換性を目的として参照しています。
    </p>
    <p>
      <a
        href="/guides/jma-spec/"
        class="underline font-medium hover:text-foreground"
        >気象庁データの仕様と注意事項・免責事項・商標注記の詳細はこちら →</a
      >
    </p>
  </div>
</section>

<style>
  /* --- ページ全体のセクション余白リズム --- */
  .hero-block {
    margin-bottom: 3.5rem;
  }
  .hero-badges {
    margin-bottom: 1rem;
  }
  .hero-block h1 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
  .hero-desc {
    margin-top: 1rem;
    line-height: 1.7;
  }

  .demo-card {
    margin-bottom: 3.5rem;
  }
  .overview-text {
    margin-top: 1.25rem;
    line-height: 1.65;
  }

  .section-heading {
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
  }

  .formats-grid {
    margin-bottom: 3.5rem;
  }
  .format-sample {
    margin-top: 0.75rem;
  }

  .quickstart-card {
    margin-bottom: 3rem;
  }
  .quickstart-step {
    margin-bottom: 1.25rem;
  }
  .quickstart-step:last-child {
    margin-bottom: 0;
  }
  .quickstart-step p {
    margin-bottom: 0.5rem;
  }

  .note-box {
    margin-top: 2.5rem;
  }
  .note-box p {
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
    line-height: 1.6;
  }
  .note-box p:first-child {
    margin-top: 0;
  }
  .note-box p:last-child {
    margin-bottom: 0;
  }
</style>
